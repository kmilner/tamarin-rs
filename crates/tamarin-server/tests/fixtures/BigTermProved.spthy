theory BigTerm

begin

// Function signature and definition of the equational theory E

functions: f/2, fst/1, g/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Init:
   [ Fr( ~x ) ]
  -->
   [
   A( g(f(~x,
          f(~x,
            f(~x,
              f(~x,
                f(~x,
                  f(~x,
                    f(~x,
                      f(~x,
                        f(~x,
                          f(~x,
                            f(~x,
                              f(~x,
                                f(~x, f(~x, f(~x, f(~x, f(~x, f(~x, f(~x, f(~x, ~x)))))))))))))))))))))
   ),
   B( g(f(~x,
          f(~x,
            f(~x,
              f(~x,
                f(~x,
                  f(~x,
                    f(~x,
                      f(~x,
                        f(~x,
                          f(~x,
                            f(~x,
                              f(~x,
                                f(~x, f(~x, f(~x, f(~x, f(~x, f(~x, f(~x, f(~x, ~x)))))))))))))))))))))
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Fin:
   [ A( y ), B( z ) ] --[ Done( y, z ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma done:
  exists-trace "∃ y z #i. Done( y, z ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ y z #i. (Done( y, z ) @ #i)"
*/
simplify
solve( A( y ) ▶₀ #i )
  case Init
  solve( B( z ) ▶₁ #i )
    case Init
    SOLVED // trace found
  qed
qed

/* All wellformedness checks were successful. */

