theory AxOne

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

restriction Ax1:
  "∀ x #i. (A( x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction R1:
  "∀ x #i. (B( x ) @ #i) ⇒ (⊥)"
  // safety formula

restriction Ax2:
  "∀ x #i. (C( x ) @ #i) ⇒ (⊥)"
  // safety formula

rule (modulo E) R:
   [ ] --[ A( 'x' ) ]-> [ ]

end
theory AxTwo

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

restriction Bx1:
  "∀ x #i. (D( x ) @ #i) ⇒ (⊥)"
  // safety formula

rule (modulo E) S:
   [ ] --[ D( 'y' ) ]-> [ ]

end
