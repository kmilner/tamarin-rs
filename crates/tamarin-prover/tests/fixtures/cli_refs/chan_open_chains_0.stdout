theory CliFlagsChan

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, sdec/2, senc/2, snd/1
equations:
    fst(<x.1, x.2>) = x.1,
    sdec(senc(x.1, x.2), x.2) = x.1,
    snd(<x.1, x.2>) = x.2

rule (modulo E) Register:
   [ Fr( ~k ) ] --[ Reg( $A, ~k ) ]-> [ !Key( $A, ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Send:
   [ !Key( $A, ~k ), Fr( ~m ) ]
  --[ Sent( $A, ~m ) ]->
   [ Out( senc(~m, ~k) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Recv:
   [ !Key( $A, k ), In( senc(m, k) ) ] --[ Recv( $A, m ) ]-> [ ]

  /* has exactly the trivial AC variant */

rule (modulo E) Reveal:
   [ !Key( $A, ~k ) ] --[ Rev( $A ) ]-> [ Out( ~k ) ]

  /* has exactly the trivial AC variant */

lemma secrecy:
  all-traces
  "∀ A m #i #j.
    ((Sent( A, m ) @ #i) ∧ (K( m ) @ #j)) ⇒ (∃ #r. Rev( A ) @ #r)"
/*
guarded formula characterizing all counter-examples:
"∃ A m #i #j.
  (Sent( A, m ) @ #i) ∧ (K( m ) @ #j) ∧ ∀ #r. (Rev( A ) @ #r) ⇒ ⊥"
*/
simplify
solve( !Key( $A, ~k ) ▶₀ #i )
  case Register
  solve( !KU( ~m ) @ #vk )
    case Reveal
    by solve( (#vl, 0) ~~> (#vk, 0) )
  next
    case Send
    solve( (#vl, 0) ~~> (#vk, 0) )
      case d_0_sdec
      solve( (#vr.3, 0) ~~> (#vk, 0) )
        case Var_fresh_1_m
        solve( !KU( ~k ) @ #vk.1 )
          case Reveal
          solve( (#vl.1, 0) ~~> (#vk.1, 0) )
            case Var_fresh_1_k
            by contradiction /* from formulas */
          qed
        next
          case Send
          solve( (#vl.1, 0) ~~> (#vk.1, 0) )
            case d_0_sdec
            by solve( (#vr.4, 0) ~~> (#vk.1, 0) )
          qed
        qed
      qed
    qed
  qed
qed

lemma exec:
  exists-trace "∃ A m #i #j. (Sent( A, m ) @ #i) ∧ (Recv( A, m ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ A m #i #j. (Sent( A, m ) @ #i) ∧ (Recv( A, m ) @ #j)"
*/
simplify
solve( !Key( $A, ~k ) ▶₀ #i )
  case Register
  solve( !Key( $A, k.1 ) ▶₀ #j )
    case Register
    solve( !KU( senc(~m, ~k.1) ) @ #vk )
      case Send
      solve( (#vl, 0) ~~> (#vk, 0) )
        case senc
        SOLVED // trace found
      qed
    qed
  qed
qed

/* All wellformedness checks were successful. */

