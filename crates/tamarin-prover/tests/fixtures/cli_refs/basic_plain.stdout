theory CliFlagsBasic

begin

// Function signature and definition of the equational theory E

functions: fst/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Gen:
   [ Fr( ~k ) ] --[ Gen( ~k ) ]-> [ St( ~k ), Out( ~k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Use:
   [ St( ~k ), In( x ) ] --[ Use( ~k, x ) ]-> [ ]

  /* has exactly the trivial AC variant */

lemma reach:
  exists-trace "∃ k x #i. Use( k, x ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ k x #i. (Use( k, x ) @ #i)"
*/
simplify
solve( St( ~k ) ▶₀ #i )
  case Gen
  SOLVED // trace found
qed

lemma leaks:
  all-traces "∀ k #i. (Gen( k ) @ #i) ⇒ (¬(∃ #j. K( k ) @ #j))"
/*
guarded formula characterizing all counter-examples:
"∃ k #i. (Gen( k ) @ #i) ∧ ∃ #j. (K( k ) @ #j)"
*/
simplify
solve( !KU( ~k ) @ #vk )
  case Gen
  SOLVED // trace found
qed

/* All wellformedness checks were successful. */

