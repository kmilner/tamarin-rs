theory KCL07

begin

// Regression fixture for replaying stored chain steps.  The theory is
// tamarin-prover/examples/csf18-xor/KCL07.spthy; the proof of
// `recentalive_tag` was found by a top-3 proof search, not the greedy
// prover.  Under `solve( (#vr.3, 0) ~~> (#vk, 0) )`, case `d_xor_case_1`, it
// solves `(#vr.6, 0) ~~> (#vk.1, 0)` while another chain goal with the same
// root names is open: a checker that matches chain goals by root name binds
// the wrong one, and every step below replays `/* unannotated */`.

// Function signature and definition of the equational theory E

builtins: xor
functions: fst/1, h/1, pair/2, snd/1
equations: fst(<x.1, x.2>) = x.1, snd(<x.1, x.2>) = x.2

rule (modulo E) Setup:
   [ Fr( ~k ), Fr( ~id ) ]
  --[ OnlyOnce( ) ]->
   [ !Reader( ~k, ~id ), !Tag( ~k, ~id ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reader1:
   [ Fr( ~r1 ) ]
  --[ Challenge( ~r1, 'Reader' ) ]->
   [ Out( ~r1 ), Initiated( ~r1 ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) tag1:
   [ In( r1 ), Fr( ~r2 ), !Tag( ~k, ~id ) ]
  --[ Response( ~k, 'Tag' ) ]->
   [ Out( <(~id⊕~r2), (~r2⊕h(<r1, ~k>))> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) reader2:
   [ Initiated( ~r1 ), !Reader( ~k, ~id ), In( xoredhash ) ]
  --[ Alive( ~k, 'Tag' ), Eq( xoredhash, (~id⊕h(<~r1, ~k>)) ) ]->
   [ ]

  /* has exactly the trivial AC variant */

restriction equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

  /*
  expanded formula:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  */

restriction unique:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  // safety formula

  /*
  expanded formula:
  "∀ #i #j. ((OnlyOnce( ) @ #i) ∧ (OnlyOnce( ) @ #j)) ⇒ (#i = #j)"
  */

lemma recentalive_tag:
  all-traces
  "∀ x #i.
    (Alive( x, 'Tag' ) @ #i) ⇒
    (∃ y #j #k.
      (((Challenge( y, 'Reader' ) @ #k) ∧ (Response( x, 'Tag' ) @ #j)) ∧
       (#k < #j)) ∧
      (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ x #i.
  (Alive( x, 'Tag' ) @ #i)
 ∧
  ∀ y #j #k.
   (Challenge( y, 'Reader' ) @ #k) ∧ (Response( x, 'Tag' ) @ #j)
  ⇒
   ((¬(#k < #j)) ∨ (¬(#j < #i)))"
*/
simplify
solve( !KU( (~id⊕h(<~r1, ~k>)) ) @ #vk )
  case c_xor
  solve( !KU( ~id ) @ #vk.1 )
    case fresh
    by solve( !Reader( ~k, ~id ) ▶₁ #i )
  next
    case reader1
    by solve( !Reader( ~k, ~id ) ▶₁ #i )
  next
    case tag1_case_1
    solve( Initiated( ~r1 ) ▶₀ #i )
      case reader1
      solve( !Reader( ~k, ~id ) ▶₁ #i )
        case Setup
        solve( !KU( ~r2 ) @ #vk.4 )
          case tag1_case_1
          by contradiction /* cyclic */
        next
          case tag1_case_2
          solve( !KU( h(<~r1, ~k>) ) @ #vk.3 )
            case c_h
            by solve( !KU( ~k ) @ #vk.8 )
          next
            case tag1
            by contradiction /* from formulas */
          qed
        qed
      qed
    qed
  next
    case tag1_case_2
    by solve( !Reader( ~k, ~id ) ▶₁ #i )
  next
    case tag1_case_3
    by solve( !Reader( ~k, ~id ) ▶₁ #i )
  qed
next
  case coerce
  solve( !KD( (~id⊕h(<~r1, ~k>)) ) ▶₀ #vk )
    case reader1
    by solve( (#vl, 0) ~~> (#vk, 0) )
  next
    case tag1
    solve( !Reader( ~k, ~id ) ▶₁ #i )
      case Setup
      solve( !Tag( ~k.1, ~id.1 ) ▶₂ #vr )
        case Setup
        solve( (#vl, 0) ~~> (#vk, 0) )
          case d_0_fst
          solve( (#vr.2, 0) ~~> (#vk, 0) )
            case d_xor_case_1
            solve( !KU( (~r2⊕z) ) @ #vk.2 )
              case c_xor_case_1
              solve( (#vr.3, 0) ~~> (#vk, 0) )
                case xor
                solve( Initiated( ~r1 ) ▶₀ #i )
                  case reader1
                  solve( !KU( ~r2 ) @ #vk.4 )
                    case tag1_case_1
                    solve( !KU( ~id ) @ #vk.5 )
                      case tag1
                      solve( !KU( ~r2.1 ) @ #vk.7 )
                        case tag1_case_1
                        by contradiction /* cyclic */
                      next
                        case tag1_case_2
                        solve( !KU( h(<~r1, ~k>) ) @ #vk.6 )
                          case c_h
                          by solve( !KU( ~k ) @ #vk.11 )
                        next
                          case tag1
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  next
                    case tag1_case_2
                    solve( !KU( h(<~r1, ~k>) ) @ #vk.4 )
                      case c_h
                      by solve( !KU( ~k ) @ #vk.8 )
                    next
                      case tag1
                      by contradiction /* from formulas */
                    qed
                  qed
                qed
              qed
            next
              case c_xor_case_2
              by solve( (#vr.3, 0) ~~> (#vk, 0) )
            next
              case coerce
              solve( !KD( (~r2⊕z) ) ▶₀ #vk.1 )
                case reader1
                solve( (#vr.3, 0) ~~> (#vk, 0) )
                  case xor
                  by solve( (#vl.1, 0) ~~> (#vk.1, 0) )
                qed
              next
                case tag1
                solve( (#vl.1, 0) ~~> (#vk.1, 0) )
                  case d_0_fst
                  solve( (#vr.3, 0) ~~> (#vk, 0) )
                    case xor
                    solve( (#vr.5, 0) ~~> (#vk.1, 0) )
                      case d_xor_case_1
                      solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                        case xor
                        solve( Initiated( ~r1 ) ▶₀ #i )
                          case reader1
                          by solve( !Tag( ~k.1, ~r2 ) ▶₂ #vr.4 )
                        qed
                      qed
                    next
                      case d_xor_case_2
                      solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                        case xor
                        by contradiction /* cyclic */
                      qed
                    next
                      case d_xor_case_3
                      by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                    next
                      case d_xor_case_4
                      by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                    qed
                  qed
                next
                  case d_0_snd
                  solve( (#vr.5, 0) ~~> (#vk.1, 0) )
                    case d_xor_case_1
                    solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                      case xor_case_1
                      by solve( (#vr.3, 0) ~~> (#vk, 0) )
                    next
                      case xor_case_2
                      solve( !KU( (z⊕h(<r1.1, ~k>)) ) @ #vk.3 )
                        case c_xor_case_1
                        solve( (#vr.3, 0) ~~> (#vk, 0) )
                          case xor
                          solve( !KU( h(<~r1, ~k>) ) @ #vk.4 )
                            case c_h
                            by solve( !KU( ~k ) @ #vk.8 )
                          next
                            case tag1
                            solve( Initiated( ~r1 ) ▶₀ #i )
                              case reader1
                              by contradiction /* from formulas */
                            qed
                          qed
                        qed
                      next
                        case c_xor_case_2
                        by solve( (#vr.3, 0) ~~> (#vk, 0) )
                      next
                        case coerce
                        solve( !KD( (z⊕h(<r1.1, ~k>)) ) ▶₀ #vk.2 )
                          case reader1
                          solve( (#vr.3, 0) ~~> (#vk, 0) )
                            case xor
                            by solve( (#vl.1, 0) ~~> (#vk.2, 0) )
                          qed
                        next
                          case tag1
                          solve( Initiated( ~r1 ) ▶₀ #i )
                            case reader1
                            solve( (#vr.3, 0) ~~> (#vk, 0) )
                              case xor
                              solve( (#vl.1, 0) ~~> (#vk.2, 0) )
                                case d_0_fst
                                solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                                  case d_xor_case_1
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                next
                                  case d_xor_case_2
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                next
                                  case d_xor_case_3
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                next
                                  case d_xor_case_4
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                qed
                              next
                                case d_0_snd
                                solve( (#vr.8, 0) ~~> (#vk.2, 0) )
                                  case d_xor_case_1
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                next
                                  case d_xor_case_2
                                  solve( !Tag( ~k.1, ~id.1 ) ▶₂ #vr.6 )
                                    case Setup
                                    solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                      case xor_case_1
                                      solve( !KU( (~r2.1⊕h(<~r1, ~k>)) ) @ #vk.4 )
                                        case c_xor
                                        solve( !KU( ~r2.1 ) @ #vk.5 )
                                          case tag1_case_1
                                          solve( !KU( ~id ) @ #vk.7 )
                                            case tag1
                                            solve( !KU( ~r2.2 ) @ #vk.9 )
                                              case tag1_case_1
                                              by contradiction /* cyclic */
                                            next
                                              case tag1_case_2
                                              solve( !KU( h(<~r1, ~k>) ) @ #vk.8 )
                                                case c_h
                                                by solve( !KU( ~k ) @ #vk.13 )
                                              next
                                                case tag1
                                                by contradiction /* from formulas */
                                              qed
                                            qed
                                          qed
                                        next
                                          case tag1_case_2
                                          solve( !KU( h(<~r1, ~k>) ) @ #vk.6 )
                                            case c_h
                                            by solve( !KU( ~k ) @ #vk.10 )
                                          next
                                            case tag1
                                            by contradiction /* from formulas */
                                          qed
                                        qed
                                      next
                                        case coerce
                                        solve( !KD( (~r2.1⊕h(<~r1, ~k>)) ) ▶₀ #vk.3 )
                                          case reader1
                                          by solve( (#vl.2, 0) ~~> (#vk.3, 0) )
                                        next
                                          case tag1
                                          solve( (#vl.2, 0) ~~> (#vk.3, 0) )
                                            case d_0_fst
                                            solve( (#vr.11, 0) ~~> (#vk.3, 0) )
                                              case d_xor_case_1
                                              solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                                case xor
                                                by solve( !Tag( ~k.1, ~id.1 ) ▶₂ #vr.10 )
                                              qed
                                            next
                                              case d_xor_case_2
                                              solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                                case xor
                                                by contradiction /* cyclic */
                                              qed
                                            next
                                              case d_xor_case_3
                                              by solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                            next
                                              case d_xor_case_4
                                              by solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                            qed
                                          next
                                            case d_0_snd
                                            solve( (#vr.11, 0) ~~> (#vk.3, 0) )
                                              case d_xor_case_1
                                              solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                                case xor
                                                by contradiction /* cyclic */
                                              qed
                                            next
                                              case d_xor_case_2
                                              solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                                case xor
                                                by contradiction /* from formulas */
                                              qed
                                            next
                                              case d_xor_case_3
                                              by solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                            next
                                              case d_xor_case_4
                                              by solve( (#vr.12, 0) ~~> (#vk.3, 0) )
                                            qed
                                          qed
                                        qed
                                      qed
                                    next
                                      case xor_case_2
                                      by contradiction /* cyclic */
                                    qed
                                  qed
                                next
                                  case d_xor_case_3
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                next
                                  case d_xor_case_4
                                  by solve( (#vr.9, 0) ~~> (#vk.2, 0) )
                                qed
                              qed
                            qed
                          qed
                        qed
                      qed
                    next
                      case xor_case_3
                      by solve( (#vr.3, 0) ~~> (#vk, 0) )
                    qed
                  next
                    case d_xor_case_2
                    solve( (#vr.3, 0) ~~> (#vk, 0) )
                      case xor
                      solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                        case xor
                        solve( Initiated( ~r1 ) ▶₀ #i )
                          case reader1
                          by contradiction /* from formulas */
                        qed
                      qed
                    qed
                  next
                    case d_xor_case_3
                    solve( (#vr.3, 0) ~~> (#vk, 0) )
                      case xor
                      by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                    qed
                  next
                    case d_xor_case_4
                    solve( (#vr.3, 0) ~~> (#vk, 0) )
                      case xor
                      by solve( (#vr.6, 0) ~~> (#vk.1, 0) )
                    qed
                  next
                    case xor
                    solve( (#vr.3, 0) ~~> (#vk, 0) )
                      case xor
                      solve( Initiated( ~r1 ) ▶₀ #i )
                        case reader1
                        by contradiction /* from formulas */
                      qed
                    qed
                  qed
                qed
              qed
            qed
          next
            case d_xor_case_2
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          next
            case d_xor_case_3
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          next
            case d_xor_case_4
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          qed
        next
          case d_0_snd
          solve( (#vr.2, 0) ~~> (#vk, 0) )
            case d_xor_case_1
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          next
            case d_xor_case_2
            solve( Initiated( ~r1 ) ▶₀ #i )
              case reader1
              solve( (#vr.3, 0) ~~> (#vk, 0) )
                case xor
                by contradiction /* cyclic */
              qed
            qed
          next
            case d_xor_case_3
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          next
            case d_xor_case_4
            by solve( (#vr.3, 0) ~~> (#vk, 0) )
          qed
        qed
      qed
    qed
  qed
qed

end