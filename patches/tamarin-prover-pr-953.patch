+==================================================
+
+theory T begin
+heuristic: sOpiO
+end
+
+---
+
+(theory
+  theory_name: (ident)
+  (global_heuristic
+    heuristic: (heuristic
+      (builtin_ranking)
+      (oracle_ranking)
+      (builtin_ranking)
+      (builtin_ranking)
+      (oracle_ranking))))
