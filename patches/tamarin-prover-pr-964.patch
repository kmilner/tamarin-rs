index 00000000..2305d41e
--- /dev/null
+++ b/examples/regression/trace/soundness-diff-multisession-restriction.spthy
@@ -0,0 +1,29 @@
+theory SoundnessDiffMultisessionRestriction
+begin
+
+rule Init:
+  [ Fr(~k) ] --> [ First(~k), Second(~k) ]
+
+rule EmitFirst:
+  [ First(k) ] --[ EmitFor(k) ]-> [ Out('ok') ]
+
+rule EmitSecond:
+  [ Second(k) ] --[ EmitFor(k) ]-> [ Out('ok') ]
+
+// The left side can emit twice from one fresh setup. The right-side
+// restriction permits only one emission per tag, so the right side outputs
+// 'ok' at most once per setup. A diff proof that checks one emission
+// dependency graph at a time cannot establish this two-branch condition.
+restriction OneEmission [right]:
+  "All k #i #j. EmitFor(k)@i & EmitFor(k)@j ==> #i=#j"
+
+lemma left_two [left]: exists-trace
+  "Ex k #i #j. EmitFor(k)@i & EmitFor(k)@j & not(#i=#j)"
+
+// This repeats the restriction as an enforcement smoke test.
+lemma right_at_most_one [right]:
+  "All k #i #j. EmitFor(k)@i & EmitFor(k)@j ==> #i=#j"
+
+diffLemma Observational_equivalence:
+
+end
diff --git a/examples/regression/trace/soundness-diff-preserved-restrictions.spthy b/examples/regression/trace/soundness-diff-preserved-restrictions.spthy
new file mode 100644
index 00000000..d925da5c
--- /dev/null
+++ b/examples/regression/trace/soundness-diff-preserved-restrictions.spthy
@@ -0,0 +1,31 @@
+theory SoundnessDiffPreservedRestrictions
+begin
+
+builtins: hashing
+
+rule Start:
+  [ Fr(~k), Fr(~m) ]
+  --[ Setup(), Started(~k) ]->
+  [ State(~k), Out(h(diff(~k,~m))) ]
+
+rule Finish:
+  [ State(k) ] --[ Finished(k) ]-> [ State(k), Out('ok') ]
+
+// These restrictions span multiple events. Their interpretation is preserved:
+// corresponding rules emit the same markers, fresh inputs are fixed, and the
+// State premise carries the same identifier through every loop iteration.
+restriction OneSetup:
+  "All #i #j. Setup()@i & Setup()@j ==> #i=#j"
+
+restriction OneFinishPerSession:
+  "All k #i #j. Finished(k)@i & Finished(k)@j ==> #i=#j"
+
+restriction FinishAfterStart:
+  "All k #i. Finished(k)@i ==> Ex #j. Started(k)@j & #j<#i"
+
+lemma completed: exists-trace
+  "Ex k #i #j. Started(k)@i & Finished(k)@j & #i<#j"
+
+diffLemma Observational_equivalence:
+
+end
