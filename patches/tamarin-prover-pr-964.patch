--- /dev/null
+++ b/examples/regression/trace/soundness-diff-conditional-restriction.spthy
@@ -0,0 +1,21 @@
+theory SoundnessDiffConditionalRestriction
+begin
+
+rule Emit:
+  [ In(x) ] --[ A(x) ]-> [ Out(x) ]
+
+// Matching this restriction to a symbolic A(x) yields the specialization
+// x='a'. That specialization is forbidden, but it cannot reject all other
+// instances of the mirror, such as the A('b') trace below.
+restriction BanA:
+  "All #i. A('a')@i ==> F"
+
+lemma left_witness [left]: exists-trace
+  "Ex #i. A('b')@i"
+
+lemma right_witness [right]: exists-trace
+  "Ex #i. A('b')@i"
+
+diffLemma Observational_equivalence:
+
+end
diff --git a/examples/regression/trace/soundness-diff-hidden-reuse.spthy b/examples/regression/trace/soundness-diff-hidden-reuse.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..ae417a67ef9d783fa8af4efc6c95d23d1980360b
--- /dev/null
+++ b/examples/regression/trace/soundness-diff-hidden-reuse.spthy
@@ -0,0 +1,32 @@
+theory SoundnessDiffHiddenReuse
+begin
+
+rule Emit:
+ [] --[ A() ]-> [ Out(diff('a','b')) ]
+
+// Deliberately false assumptions distinguish permitted conditional reuse from
+// a hidden dependency. Both sides use the same name to exercise side identity.
+lemma assumed [left,reuse,diff_reuse]:
+ "All #i. A()@i ==> F"
+lemma assumed [right,reuse,diff_reuse]:
+ "All #i. A()@i ==> F"
+
+lemma hidden [left,hide_lemma=assumed]:
+ "All #i. A()@i ==> F"
+lemma hidden [right,hide_lemma=assumed]:
+ "All #i. A()@i ==> F"
+lemma hidden_all [left,hide_lemma=ALL]: exists-trace
+ "Ex #i. A()@i"
+lemma hidden_all [right,hide_lemma=ALL]: exists-trace
+ "Ex #i. A()@i"
+
+// Reuse remains intentionally conditional when the assumption is visible.
+lemma visible [left]:
+ "All #i. A()@i ==> F"
+lemma visible [right]:
+ "All #i. A()@i ==> F"
+
+diffLemma Hidden [hide_lemma=assumed]:
+diffLemma HiddenAll [hide_lemma=ALL]:
+diffLemma Visible:
+end
