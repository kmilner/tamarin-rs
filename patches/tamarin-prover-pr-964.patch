diff --git a/examples/regression/trace/soundness-diff-unreachable-trivial-goal.spthy b/examples/regression/trace/soundness-diff-unreachable-trivial-goal.spthy
new file mode 100644
index 00000000..64b31015
--- /dev/null
+++ b/examples/regression/trace/soundness-diff-unreachable-trivial-goal.spthy
@@ -0,0 +1,26 @@
+theory SoundnessDiffUnreachableTrivialGoal
+begin
+
+// The only source of F is forbidden on both sides, so Unreachable cannot
+// execute. BanA is therefore redundant and both restricted trace sets agree.
+rule Produce:
+  [] --[ P() ]-> [ F('a') ]
+
+rule Unreachable:
+  [ F(x) ] --[ A(x) ]-> [ Out('ok') ]
