diff --git a/examples/regression/trace/diff-multisession-observable-restriction.spthy b/examples/regression/trace/diff-multisession-observable-restriction.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..c00c8bcc1486a119f2e355bd136817f4e57d8dfb
--- /dev/null
+++ b/examples/regression/trace/diff-multisession-observable-restriction.spthy
@@ -0,0 +1,45 @@
+theory DiffMultisessionObservableRestriction
+begin
+
+builtins: symmetric-encryption, hashing
+
+// Each session publishes a commitment to a fresh secret. Its two remaining
+// rules can release the encryption key and the encrypted secret separately.
+rule Init:
+  [ Fr(~k), Fr(~s) ] --[ Secret(~s) ]->
+  [ First(~k), Second(~k,~s), Out(h(~s)) ]
+
+rule EmitKey:
+  [ First(k) ] --[ EmitFor(k), KeySent(k) ]-> [ Out(k) ]
+
+rule EmitCiphertext:
+  [ Second(k,s) ] --[ EmitFor(k), CiphertextSent(s,k) ]-> [ Out(senc(s,k)) ]
+
+// On the right, either output is possible, but they cannot both come from
+// the same session. Starting another session supplies a different fresh key.
+restriction OneEmission [right]:
+  "All k #i #j. EmitFor(k)@i & EmitFor(k)@j ==> #i=#j"
+
+lemma left_leaks [left]: exists-trace
+  "Ex s #i #j. Secret(s)@i & K(s)@j"
+
+lemma right_secret [right]:
+  "All s #i #j. Secret(s)@i & K(s)@j ==> F"
+
+lemma right_key_reachable [right]: exists-trace
+  "Ex k #i. KeySent(k)@i"
+
+lemma right_ciphertext_reachable [right]: exists-trace
+  "Ex s k #i. CiphertextSent(s,k)@i"
+
+// This difference is observable: with outputs c=h(s), k and e=senc(s,k),
+// the attacker can test h(sdec(e,k))=c. It succeeds on the left; the right
+// cannot supply both k and e for that commitment. The secrecy lemmas above
+// check the corresponding knowledge difference, and the reachability lemmas
+// confirm that the right-hand restriction still allows either output alone.
+//
+// This supplements the internal-event example. Equivalence should remain
+// incomplete or report an attack; a bound of 6 completes all four side lemmas.
+diffLemma Observational_equivalence:
+
+end
diff --git a/examples/regression/trace/diff-side-restriction-choices.spthy b/examples/regression/trace/diff-side-restriction-choices.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..0815ace1bb978d5b9fcfbec3dcdb7472adef1e86
--- /dev/null
+++ b/examples/regression/trace/diff-side-restriction-choices.spthy
@@ -0,0 +1,54 @@
+theory DiffSideRestrictionChoices
+begin
+
+// Side-only public choices belong to their own restriction, not to the
+// positional choices fixed when constructing the opposite rule instance.
+// These local obligations currently leave equivalence incomplete; they must
+// neither crash mirroring nor turn a satisfiable choice into a false attack.
+#ifdef not (REVERSE | SHARED | CONTROL | BLOCKED | ERASED)
+rule P: [] --[Made('ok')]-> [Out('ok')]
+left rule P: [] --[Made('ok'), _restrict($a='left')]-> [Out('ok')]
+right rule P: [] --[Made('ok')]-> [Out('ok')]
+#endif
+#ifdef REVERSE
+rule P: [] --[Made('ok')]-> [Out('ok')]
+left rule P: [] --[Made('ok')]-> [Out('ok')]
+right rule P: [] --[Made('ok'), _restrict($a='right')]-> [Out('ok')]
+#endif
+#ifdef SHARED
+// The local names sort before z and differ in number on the two sides.
+// They must not displace the parent's shared choice or be paired together.
+rule P:
+  [] --[Made($z), _restrict($z='ok')]-> [Out($z)]
+left rule P:
+  [] --[Made($z), _restrict($a='left')]-> [Out($z)]
+right rule P:
+  [] --[Made($z), _restrict($b='right' & $c='other')]-> [Out($z)]
+#endif
+
+#ifdef CONTROL
+// Parent choices still have a positional correspondence, including choices
+// introduced by its own embedded restrictions.
+rule P: [] --[Made($z), _restrict($z='ok')]-> [Out($z)]
+left rule P: [] --[Made($z)]-> [Out($z)]
+right rule P: [] --[Made($z)]-> [Out($z)]
+#endif
+#ifdef BLOCKED
+// Contradictory side restrictions must still prevent the rule from firing.
+rule P: [] --[Made('ok')]-> [Out('ok')]
+left rule P: [] --[Made('ok'), _restrict($a='left' & $a='right')]-> [Out('ok')]
+right rule P: [] --[Made('ok')]-> [Out('ok')]
+#endif
+
+#ifdef ERASED
+// Although p occurs in the source parent, macro expansion removes it. The
+// two side-local choices named p must therefore remain independent.
+macros: erase(x)='ok'
+rule P: [] --[Made(erase($p))]-> [Out(erase($p))]
+left rule P: [] --[Made('ok'), _restrict($p='left')]-> [Out('ok')]
+right rule P: [] --[Made('ok'), _restrict($p='right')]-> [Out('ok')]
+#endif
+
+lemma reachable: exists-trace "Ex #i. Made('ok')@i"
+diffLemma D:
+end
