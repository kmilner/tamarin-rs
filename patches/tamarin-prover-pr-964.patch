+// equality in the right source cache would incorrectly eliminate B('b').
+lemma left_source [left,sources]:
+  "All x #i. A(x)@i ==> x = 'a'"
+
+lemma right_counterexample [right]:
+  "All #i. B('b')@i ==> F"
