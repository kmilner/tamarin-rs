+// action guard nested beside them cannot make the Boolean formula irrelevant.
+restriction Impossible [right]:
+  "(('a' = 'b') & (All #i. A('a')@i ==> F)) | ('c' = 'd')"
+
+lemma left_witness [left]: exists-trace
+  "Ex #i. A('b')@i"
