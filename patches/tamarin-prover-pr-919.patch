         FApp (AC Mult)     ts                     -> ppTerms "*" 1 "(" ")" ts
         FApp (AC Xor)      ts                     -> ppTerms "⊕" 1 "(" ")" ts
         FApp (AC Union)    ts                     -> ppTerms "++" 1 "(" ")" ts
@@ -316,9 +316,20 @@ prettyTerm ppLit = ppTerm
