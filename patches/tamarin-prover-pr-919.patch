diff --git a/examples/regression/trace/issue914.spthy b/examples/regression/trace/issue914.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..9f758fc48f5a8c3d1a4b12d349e89af0bd897d00
--- /dev/null
+++ b/examples/regression/trace/issue914.spthy
@@ -0,0 +1,21 @@
+/*
+ * Regression test for issue #914.
+ * A user-defined AC operator binds more tightly than '^'.
+ * The printer must keep parentheses around a '^' argument.
+ * Without them, the stored theory reads back as a different
+ * theory, and the verdict flips from falsified to verified.
+ */
+theory Issue914
+begin
+
+builtins: diffie-hellman
+functions: add/2 [AC]
+
+rule Gen:
+  [ Fr(~e) ] --[ Secret( add('g'^~e, 'pad') ) ]-> [ Out( 'g'^~e ) ]
+
+lemma secrecy:
+  all-traces
+  "All m #i. Secret(m) @ #i ==> not (Ex #j. K(m) @ #j)"
+
+end
