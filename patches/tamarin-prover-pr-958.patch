diff --git a/examples/regression/trace/msr-injective-last.spthy b/examples/regression/trace/msr-injective-last.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..ec1eef32387cada16e529ce2f105eb811a55ea10
--- /dev/null
+++ b/examples/regression/trace/msr-injective-last.spthy
@@ -0,0 +1,66 @@
+theory InjectiveLast
+begin
+
+rule Create: [Fr(~id)] --[Cr(~id)]-> [S(~id), Once(~id)]
+rule Use: [S(id), Once(id)] --[Use(id)]-> [S(id)]
+rule Fin: [S(id)] --[Fin(id), FinArgument(id,$x)]-> []
+
+tactic: prem
+presort: S
+prio:
+  regex "last\(#j\)"
+prio:
+  regex "▶₀ #j"
+
+// Both Fin variables can denote the same event. Induction introduces last
+// internally; the input formula does not use that internal atom.
+lemma induction_counterexample [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k & #i < #j & #i < #k
+    & not (Ex #u. Use(id)@u) ==> F"
+lemma direct_counterexample:
+  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k & #i < #j & #i < #k
+    & not (Ex #u. Use(id)@u) ==> F"
+lemma witness: exists-trace
+  "Ex id #i #j. Cr(id)@i & Fin(id)@j & #i < #j & not (Ex #u. Use(id)@u)"
+
+// A counterexample requires distinct Fin nodes. Merging them must expose the
+// contradictory disequality to the existing formula simplifier.
+lemma distinct_finals_impossible [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k & #i < #j & #i < #k
+    ==> #j=#k"
+
+// The merge requires an edge ending at the last node. An earlier use can
+// consume and reproduce the state before Fin consumes its successor.
+lemma used_witness: exists-trace
+  "Ex id #i #j #k. Cr(id)@i & Use(id)@j & Fin(id)@k & #i < #j & #j < #k"
+
+// Strict ordering prevents the two Fin nodes from denoting the same event,
+// in either direction and when the ordering follows a longer path.
+lemma ordered_finals_impossible [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k
+    & #i < #j & #j < #k ==> F"
+lemma reverse_ordered_finals_impossible [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k
+    & #i < #k & #k < #j ==> F"
+lemma transitively_ordered_finals_impossible [use_induction, heuristic={prem}]:
+  "All id #i #j #u #k. Cr(id)@i & Fin(id)@j & Use(id)@u & Fin(id)@k
+    & #i < #j & #j < #u & #u < #k ==> F"
+
+// An ordering inside a disjunction is not yet a strict-order constraint.
+// The equality branch still has a witness, so this lemma must be falsified.
+lemma equality_or_order_counterexample [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & Fin(id)@j & Fin(id)@k
+    & #i < #j & #i < #k & (#j = #k | #j < #k) ==> F"
+
+// The public argument appears only in the action. Merging last nodes must
+// unify the entire rule instances, including this argument.
+lemma incompatible_final_arguments [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & FinArgument(id,'a')@j & FinArgument(id,'b')@k
+    & #i < #j & #i < #k ==> F"
+
+// Both requests can refer to the same event with the same argument.
+lemma equal_final_arguments_counterexample [use_induction, heuristic={prem}]:
+  "All id #i #j #k. Cr(id)@i & FinArgument(id,'a')@j & FinArgument(id,'a')@k
+    & #i < #j & #i < #k ==> F"
+
+end
diff --git a/examples/regression/trace/msr-macro-injectivity.spthy b/examples/regression/trace/msr-macro-injectivity.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..b0d4d826e662e43903f9bec20ae335750e486f3a
--- /dev/null
+++ b/examples/regression/trace/msr-macro-injectivity.spthy
@@ -0,0 +1,25 @@
+theory MacroInjectivity
+begin
+
+macros: identity(x) = x, constant(x) = 'c', projection(x) = fst(<x, 'c'>)
+
+rule Init:
+  [Fr(~id), In(x)] --> [S(~id, x), C(~id, x), P(~id, x)]
+rule Identity:
+  [S(~id, x)] --[Identity(~id, x)]-> [S(~id, identity(x))]
+rule Constant:
+  [C(~id, x)] --[Constant(~id, x)]-> [C(~id, constant(x))]
+rule Projection:
+  [P(~id, x)] --[Projection(~id, x)]-> [P(~id, projection(x))]
+
+// Macro calls must not be mistaken for strictly increasing constructors.
+lemma identity_twice: exists-trace
+  "Ex id x #i #j. Identity(id,x)@i & Identity(id,x)@j & not (#i = #j)"
+lemma identity_once:
+  "All id x #i #j. Identity(id,x)@i & Identity(id,x)@j ==> #i = #j"
+lemma constant_twice: exists-trace
+  "Ex id #i #j. Constant(id,'c')@i & Constant(id,'c')@j & not (#i = #j)"
+lemma projection_twice: exists-trace
+  "Ex id x #i #j. Projection(id,x)@i & Projection(id,x)@j & not (#i = #j)"
+
+end
diff --git a/examples/regression/trace/msr-source-premise-index.spthy b/examples/regression/trace/msr-source-premise-index.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..5cefab9c2e8682bf83da7567dde9f594937ce50d
--- /dev/null
+++ b/examples/regression/trace/msr-source-premise-index.spthy
@@ -0,0 +1,40 @@
+theory SourcePremiseIndex
+begin
+
+rule Create: [Fr(~x)] --[Cr(~x)]-> [S(~x), !Permit(~x)]
+rule Twice: [S(x), S(x)] --[Twice(x)]-> []
+rule Three: [S(x), !Permit(x), S(x)] --[Three(x)]-> []
+rule CreateTwo: [Fr(~x)] --> [T(~x), T(~x)]
+rule ConsumeTwo: [T(x), T(x)] --[ConsumedTwo(x)]-> []
+
+tactic: prem1
+presort: S
+prio:
+  regex "▶₁"
+
+tactic: prem2
+presort: S
+prio:
+  regex "▶₂"
+
+// A source for premise one must not mark premise zero as solved.
+lemma impossible_second_first [heuristic={prem1}]:
+  "All x #i. Twice(x)@i ==> F"
+lemma impossible_default:
+  "All x #i. Twice(x)@i ==> F"
+lemma no_witness_second_first [heuristic={prem1}]: exists-trace
+  "Ex x #i. Twice(x)@i"
+lemma no_witness_default: exists-trace
+  "Ex x #i. Twice(x)@i"
+lemma impossible_third_first [heuristic={prem2}]:
+  "All x #i. Three(x)@i ==> F"
+lemma no_witness_third_first [heuristic={prem2}]: exists-trace
+  "Ex x #i. Three(x)@i"
+
+// Distinct linear tokens from one rule may supply the two premises.
+lemma witness_second_first [heuristic={prem1}]: exists-trace
+  "Ex x #i. ConsumedTwo(x)@i"
+lemma witness_default: exists-trace
+  "Ex x #i. ConsumedTwo(x)@i"
+
+end
diff --git a/examples/regression/trace/nat-subterm-sorts.spthy b/examples/regression/trace/nat-subterm-sorts.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..7210afef83412916fe885e2f900b813dd72e88db
--- /dev/null
+++ b/examples/regression/trace/nat-subterm-sorts.spthy
@@ -0,0 +1,64 @@
+theory NatSubtermSorts
+begin
+
+builtins: natural-numbers, hashing
+
+rule Hash:
+  [ In(%n) ] --[ Hash(h('a'), %n) ]-> []
+
+rule Compare:
+  [ In(x), In(%n) ] --[ Compare(x, %n) ]-> []
+
+rule Restricted:
+  [ In(x), In(%n) ] --[ A(x), B(x, %n) ]-> []
+
+restriction no_nat:
+  "All %m #i. A(%m)@i ==> F"
+
+// A negative mixed-sort subterm must not be flipped to natural arithmetic.
+// Expected: falsified; the reachable hash is not a subterm of a natural.
+lemma hash_is_smaller:
+  "All x %n #i. Hash(x, %n)@i ==> x << %n"
+
+// Expected: verified.
+lemma hash_is_not_smaller:
+  "All x %n #i. Hash(x, %n)@i ==> not (x << %n)"
+
+lemma hash_event_exists:
+  exists-trace "Ex x %n #i. Hash(x, %n)@i"
+
+// Refining a positive mixed-sort subterm must preserve valid witnesses.
+lemma mixed_positive_exists:
+  exists-trace "Ex x %n #i. Compare(x, %n)@i & x << %n"
+
+lemma mixed_negative_exists:
+  exists-trace "Ex x %n #i. Compare(x, %n)@i & not (x << %n)"
+
+// A deferred negative subterm must still hold when x becomes a natural.
+lemma mixed_negative_equal_exists:
+  exists-trace
+  "Ex x %n #i. Compare(x, %n)@i & x = %n & not (x << %n)"
+
+lemma typed_successor_exists:
+  exists-trace "Ex #i. Compare(%1, %1 %+ %1)@i & %1 << %1 %+ %1"
+
+lemma typed_not_reflexive:
+  "All %n #i. Compare(%n, %n)@i ==> not (%n << %n)"
+
+// Keep the valid negative-flipping rule for two natural operands.
+lemma typed_total_order:
+  "All %m %n #i. Compare(%m, %n)@i
+    ==> (%m << %n | %n << %m | %m = %n)"
+
+// Positive x << %n must refine x to nat and activate no_nat.
+lemma restricted_subterm:
+  "All x %n #i. B(x, %n)@i ==> not (x << %n)"
+
+lemma restricted_equality:
+  "All x %n #i. B(x, %n)@i ==> not (x = %n)"
+
+// The restriction still permits non-natural messages.
+lemma restricted_non_nat_exists:
+  exists-trace "Ex %n #i. B('a', %n)@i"
+
+end
diff --git a/examples/regression/trace/soundness-induction-empty-equality.spthy b/examples/regression/trace/soundness-induction-empty-equality.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..1b885b9d27ff17f963f12d1bbf46a79e9a767168
--- /dev/null
+++ b/examples/regression/trace/soundness-induction-empty-equality.spthy
@@ -0,0 +1,20 @@
+theory SoundnessInductionEmptyEquality
+begin
+
+// This rule supplies the action-bearing part of the formula that made the
+// old induction applicability check accept the lemma. A is reachable: the
+// intruder can generate a fresh name and send it.
+rule Receive:
+  [ In(~x) ]
+  --[ A() ]->
+  []
+
+// Message quantifiers range over terms even on the empty trace. In particular,
+// x='a' has the witness x='a', so this conjunction is false on every trace.
+lemma false_direct:
+  "(All x. x='a' ==> F) & (All #i. A()@i ==> T)"
+
+lemma false_induction [use_induction]:
+  "(All x. x='a' ==> F) & (All #i. A()@i ==> T)"
+
+end
