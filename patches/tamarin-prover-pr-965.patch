+theory DiffExplicitSideRuleMacros
+begin
+
+functions: h/1
+
+macros: m(x) = h(x)
+
+/* An explicit side rule may use macros: after expansion, this left rule
+   is the parent's projection. Both sides output h(x), so the equivalence
+   holds. */
+rule Hash: [ In(x) ] --[ H(x) ]-> [ Out(h(x)) ]
+left rule Hash: [ In(x) ] --[ H(x) ]-> [ Out(m(x)) ]
+right rule Hash: [ In(x) ] --[ H(x) ]-> [ Out(h(x)) ]
+
+diffLemma Observational_equivalence:
+
+end
diff --git a/examples/regression/trace/diff-explicit-side-rule-renaming.spthy b/examples/regression/trace/diff-explicit-side-rule-renaming.spthy
new file mode 100644
index 00000000..db33f522
--- /dev/null
+++ b/examples/regression/trace/diff-explicit-side-rule-renaming.spthy
@@ -0,0 +1,26 @@
+theory DiffExplicitSideRuleRenaming
+begin
+
+/* Explicit side rules that rename the parent's variables are justified by
+   the parent, as explicit variant members are by the computed variants.
+   Every side below is its parent's projection, so the equivalence holds. */
+
+// The left rule renames $p to $z. Its own new variables would sort as
+// [$q, $z] against the parent's [$p, $q]; mirroring pairs new variables by
+// position, so the side rule takes the parent's slots in its names.
+// Develop, which only warned, falsified the equivalence.
+rule Pick: [ ] --[ A($p, $q) ]-> [ Out(<$p, $q>) ]
+left rule Pick: [ ] --[ A($z, $q) ]-> [ Out(<$z, $q>) ]
+right rule Pick: [ ] --[ A($p, $q) ]-> [ Out(<$p, $q>) ]
+
+restriction distinct:
+  "All x y #i. A(x, y)@i ==> not (x = y)"
+
+// The left rule renames a premise variable.
+rule Hash: [ In(x) ] --[ H(x) ]-> [ Out(<x, x>) ]
+left rule Hash: [ In(y) ] --[ H(y) ]-> [ Out(<y, y>) ]
+right rule Hash: [ In(x) ] --[ H(x) ]-> [ Out(<x, x>) ]
+
+diffLemma Observational_equivalence:
+
+end
diff --git a/examples/regression/trace/diff-explicit-side-rules.spthy b/examples/regression/trace/diff-explicit-side-rules.spthy
new file mode 100644
index 00000000..e88c2c83
--- /dev/null
+++ b/examples/regression/trace/diff-explicit-side-rules.spthy
@@ -0,0 +1,23 @@
+theory DiffExplicitSideRules
+begin
+builtins: diffie-hellman
+
+// An explicit side rule replaces the parent's projection on its side. This
+// left rule emits A('b') where the parent emits A('a'), so the proof would
+// not be about the declared diff rule. Develop only warned, then falsified
+// left_a.
+rule Emit: [] --[ A('a') ]-> [ Out('a') ]
+left rule Emit: [] --[ A('b') ]-> [ Out('a') ]
+right rule Emit: [] --[ A('a') ]-> [ Out('a') ]
+
+// Actions added by a side rule get the parent's product check: x*y is read
+// modulo AC only, so x = 'a' and y = inv('a') do not give the unit, and
+// develop silently verified the false unit_never.
+rule Product: [ In(x), In(y) ] --> []
+left rule Product: [ In(x), In(y) ] --[ Product(x*y) ]-> []
+right rule Product: [ In(x), In(y) ] --> []
+
+lemma left_a [left]: exists-trace "Ex #i. A('a')@i"
+lemma unit_never [left]: "All #i. Product(1)@i ==> F"
+
+end
