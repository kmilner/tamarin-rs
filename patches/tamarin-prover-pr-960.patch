diff --git a/examples/regression/trace/sapic-open-process-export.spthy b/examples/regression/trace/sapic-open-process-export.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..d622ad9df5cb212c639c61601ec60c0b10a66a10
--- /dev/null
+++ b/examples/regression/trace/sapic-open-process-export.spthy
@@ -0,0 +1,21 @@
+theory SapicOpenProcessExport
+begin
+
+// P captures the x at each call. Export used to declare P(x) but print P(),
+// losing the association with the two different fresh names in the callers.
+let P = event Seen(x)
+let Wrapped(x) = P
+
+process:
+  (new x; event Created(x); P) |
+  (new x; event Created(x); P) |
+  Wrapped('a')
+
+lemma caller_binding:
+  "All x #i. Seen(x)@i ==> x = 'a' | (Ex #j. Created(x)@j & j < i)"
+lemma distinct_callers: exists-trace
+  "Ex x y #i #j #k #l. Created(x)@i & Created(y)@j &
+     Seen(x)@k & Seen(y)@l & not(x = y)"
+lemma closed_wrapper: exists-trace "Ex #i. Seen('a')@i"
+
+end
