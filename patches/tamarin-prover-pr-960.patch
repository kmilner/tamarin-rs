diff --git a/examples/regression/trace/sapic-variant-action-control.spthy b/examples/regression/trace/sapic-variant-action-control.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..a62c76928da63b90c7691f254836ca73ce3f6974
--- /dev/null
+++ b/examples/regression/trace/sapic-variant-action-control.spthy
@@ -0,0 +1,20 @@
+theory SapicVariantActionControl
+begin
+builtins: symmetric-encryption
+// A complete variant family may still add ordinary user actions. Unlike
+// SAPIC's reserved Insert action, UserInsert does not change the store.
+rule Fake:
+  [ Trigger(), In(x), In(k) ] --> [ Continue(), Out(sdec(x,k)) ]
+variants
+rule (modulo AC) Fake___VARIANT_1:
+  [ Trigger(), In(x.2), In(k.1) ] --[ UserInsert('a','y') ]-> [ Continue(), Out(sdec(x.2,k.1)) ],
+rule (modulo AC) Fake___VARIANT_2:
+  [ Trigger(), In(senc(z.2,k.1)), In(k.1) ] --[ UserInsert('a','y') ]-> [ Continue(), Out(z.2) ]
+process:
+  insert 'a','x';
+  [] --> [ Trigger() ];
+  [ Continue() ] --> [];
+  lookup 'a' as v in event Got(v)
+lemma got_x: exists-trace "Ex #i. Got('x')@i"
+lemma only_y: "All v #i. Got(v)@i ==> v = 'y'"
+end
