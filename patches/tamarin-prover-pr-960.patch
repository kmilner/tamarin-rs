diff --git a/examples/regression/negative/sapic-parameter-rebound-let.spthy b/examples/regression/negative/sapic-parameter-rebound-let.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..9d2a5013ffafaf14161d9baa37df3f2db8eb8df7
--- /dev/null
+++ b/examples/regression/negative/sapic-parameter-rebound-let.spthy
@@ -0,0 +1,8 @@
+theory SapicParameterReboundLet
+begin
+// The let would bind the parameter x again. Substituting the argument 'b'
+// used to turn it into the match 'b'='a' and silently remove every E event.
+let P(x) = let x = 'a' in event E(x)
+process: P('b')
+lemma never_E: "All y #i. E(y)@i ==> F"
+end
