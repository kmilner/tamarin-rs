diff --git a/examples/regression/trace/soundness-sapic-binder-scope.spthy b/examples/regression/trace/soundness-sapic-binder-scope.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..688af891a864133ea1c7daaece8f4a8e9a8851a8
--- /dev/null
+++ b/examples/regression/trace/soundness-sapic-binder-scope.spthy
@@ -0,0 +1,17 @@
+theory SoundnessSapicBinderScope
+begin
+// Each process binds x again. Uniqueness renaming must rename the new binder
+// only in its scope: the else branch, the let right-hand side and the lookup
+// key still refer to the input x.
+process:
+    (in(x); event Input('else',x); lookup 'unset' as x in event Found(x)
+       else event Missing(x))
+  | (in(x); event Input('let',x); let <x,y> = x in event Parts(x,y))
+  | (insert 'key','value'; in(x); lookup x as x in event Read(x))
+lemma else_outer:
+  "All v #i. Missing(v)@i ==> Ex #j. Input('else',v)@j & j < i"
+lemma let_outer:
+  "All a b #i. Parts(a,b)@i ==> Ex #j. Input('let',<a,b>)@j & j < i"
+lemma key_outer: exists-trace
+  "Ex #i. Read('value')@i"
+end
diff --git a/examples/regression/trace/soundness-sapic-pattern-export.spthy b/examples/regression/trace/soundness-sapic-pattern-export.spthy
new file mode 100644
index 0000000000000000000000000000000000000000..e5933dfe9e6fa1ee653346456d6cf8b085ed7713
--- /dev/null
+++ b/examples/regression/trace/soundness-sapic-pattern-export.spthy
@@ -0,0 +1,21 @@
+theory SoundnessSapicPatternExport
+begin
+
+// Typed export used to rename the input binder independently of its formal,
+// so reparsing P's export accepted any input instead of the supplied pattern.
+let P(pat_x) = in(pat_x); event Seen(pat_x)
+let Twice(pat_x) = in(pat_x); in(pat_x); event Twice(pat_x)
+let Nested(pat_x) = P(pat_x)
+let Value(x) = event Value(x)
+
+process: P(<'a','b'>) | Twice('c') | Nested('d') | Value('e')
+
+lemma supplied_patterns:
+  "All x #i. Seen(x)@i ==> x = <'a','b'> | x = 'd'"
+lemma repeated_pattern: "All x #i. Twice(x)@i ==> x = 'c'"
+lemma pair_reachable: exists-trace "Ex #i. Seen(<'a','b'>)@i"
+lemma nested_reachable: exists-trace "Ex #i. Seen('d')@i"
+lemma repeated_reachable: exists-trace "Ex #i. Twice('c')@i"
+lemma ordinary_parameter: exists-trace "Ex #i. Value('e')@i"
+
+end
