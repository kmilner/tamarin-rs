+
+1. !Key( ~k )
+
+2. NaturalState( %x )
+
+3. NaturalState( %z )
+
+4. NaturalState( %1 )
+
+5. State( 'a' )
+
+6. State( 'b' )
+
+7. Fr( ~z )
+
+8. Out( z )
+
+9. In( z )
+
+This abstract state results in 11 refined multiset rewriting rules.
+Kept 1 original rule families to preserve their variants on export.
+Note that the original number of multiset rewriting rules was 11.
+
+*}
+
+rule (modulo E) Key:
+   [ Fr( ~k ) ] --> [ !Key( ~k ) ]
+
+  /* has exactly the trivial AC variant */
+
+rule (modulo E) Secret:
+   [ Fr( ~m.1 ), !Key( ~k ) ]
+  --[ Secret( ~m.1 ) ]->
+   [ Out( senc(~m.1, ~k) ) ]
+
+  /* has exactly the trivial AC variant */
+
+rule (modulo E) Dec:
+   [ In( x ), !Key( k ) ] --> [ Out( sdec(x, k) ) ]
+ variants
+  rule (modulo AC) Dec___VARIANT_2:
+     [ In( senc(z.2, k.1) ), !Key( k.1 ) ]
+    --[ Decrypted( z.2 ) ]->
+     [ Out( z.2 ) ]
+  ,
+  rule (modulo AC) Dec___VARIANT_1:
+     [ In( x.2 ), !Key( k.1 ) ]
+    --[ Unreduced( sdec(x.2, k.1) ) ]->
+     [ Out( sdec(x.2, k.1) ) ]
+
+lemma unreduced_secret:
+  exists-trace "∃ m #i #j. (Secret( m ) @ #i) ∧ (Unreduced( m ) @ #j)"
+/*
+guarded formula characterizing all satisfying traces:
+"∃ m #i #j. (Secret( m ) @ #i) ∧ (Unreduced( m ) @ #j)"
