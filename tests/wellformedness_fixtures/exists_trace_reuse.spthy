// Fixture: triggers `Lemma annotations`.
// A `[reuse]` annotation on an `exists-trace` lemma: reuse only makes
// sense for all-traces lemmas.
theory ExistsTraceReuse
begin

rule Setup:
   [ Fr(~x) ]
  --[ Setup(~x) ]->
   [ Out(~x) ]

lemma exist_reuse [reuse]:
  exists-trace
  "Ex x #i. Setup(x) @ i"

end
