// Fixture: the conclusion product triggers both the legacy multiplication
// restriction and the unsupported-products check. The same product in the
// premise binds its variables, so no unbound-variable warning is involved.
theory MultLhs
begin

builtins: diffie-hellman

rule Bad:
   [ Fr(~x), In(a*b) ]
  --[ ]->
   [ Out(<~x, a*b>) ]

end
