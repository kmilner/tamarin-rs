// Two lemmas that are both `reuse` and `exists-trace`.
//
// `lemmaAttributeReport` (Theory/Tools/Wellformedness.hs:924-932) is a
// list-monad `do` over the theory's lemmas, so it yields one report ENTRY per
// offending lemma.  The trailing count line is `length rep`
// (Main/Mode/Batch.hs:246), which therefore counts two, while the
// `Lemma annotations` block itself carries one header and both bodies.
//
// Compared slice: the run summary, which is where the count is printed.  No
// corpus theory writes two such lemmas, so this is the only cover for the
// count.


theory S8TwoReuseExistsLemmas
begin

rule R:
  [ Fr(~x) ] --[ A(~x) ]-> [ Out(~x) ]

lemma one [reuse]:
  exists-trace "Ex x #i. A(x) @ #i"

lemma two [reuse]:
  exists-trace "Ex y #j. A(y) @ #j"

end
