// Both independent triggers of multRestrictedReport' in
// Theory/Tools/Wellformedness.hs, one rule each:
// - ConclusionProduct lists conclusion products as sorted multisets, in
//   conclusion-term order. Action products appear only in the separate
//   unsupported-product report.
// - LhsAbstraction replaces reducible premise terms with fresh variables,
//   leaving w and z unbound. prettyVarList prints them in Ord LVar order.
//
// MSR export exposes both reports; proof/load mode rejects products outside
// exponents before closing. cli_e2e's
// unsupported_products_report_on_stdout_and_abort_on_stderr covers rejection.
//
// check.sh compares the wellformedness report and theory echo. The long action
// list exercises their different layout widths: addComment's render uses
// HughesPJ's 100/67 (TheoryObject.hs), while renderDoc uses the console's
// 110/73 (Main/Console.hs). The actions wrap only in the report.

theory MultRestrictedReport
begin

builtins: diffie-hellman

rule ConclusionProduct:
  [ Fr(~a), Fr(~b), Fr(~c) ]
  --[ ActionOnly( (~a*~c) ), ActionOnly( (~c*~c*~a) ), ActionOnly( ~b ) ]->
  [ Out( <(~a*~b), (~b*~a*~a)> ) ]

rule LhsAbstraction:
  [ In( <fst(z), snd(w)> ) ] --[ Seen( 'c' ) ]-> [ Out( <z, w> ) ]

end
