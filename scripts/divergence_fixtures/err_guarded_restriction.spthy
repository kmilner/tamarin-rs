// Category: fatal errors — the run's outcome (exit code and error kind).
//
// An unguardable restriction under --precompute-only dies at the GHC
// exception boundary (`unguarded variable`).
// No corpus theory fails this way.

theory GuardedRestriction
begin

rule R:
    [] --[ A() ]-> []

restriction bad:
    "All x #i. A() @ #i ==> x = x"

lemma ok:
    exists-trace "Ex #i. A() @ #i"

end
