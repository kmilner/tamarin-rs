// Category: fatal errors — the run's outcome (exit code and error kind).
//
// Two rules under one name that differ in an embedded restriction:
// `duplicate rule`.
// No corpus theory fails this way.

theory RuleDuplicateRestrict begin
rule R1: [ ] --> [ Out('a') ]
rule R1: [ ] --[ _restrict( All x #i #j. A(x) @ #i & A(x) @ #j ==> #i = #j ) ]-> [ Out('a') ]
end
