/*
 * Prefix (and op{t1}t2) applications of a user-declared `[AC]` symbol:
 * `naryOpApp`'s arity check is gated on `NotAC` (Term.hs:98), so ANY
 * argument count parses:
 *
 *   - f('a','b','c')  fAppAC flattens to the same term the infix chain
 *                     builds — ('a' f 'b' f 'c');
 *   - f('a')          `fAppAC _ [a] = a` (Term/Term/Raw.hs:118-121): the
 *                     singleton application collapses to its argument;
 *   - f{'x'}'y'       `binaryAlgApp`'s IsAC branch builds fAppAC too
 *                     (Term.hs:119-121) — ('x' f 'y').
 */
theory AcPrefixArities
begin

functions: f/2 [AC]

rule r:
  [ ] --> [ Out(f('a','b','c')), Out(f('a')), Out(f{'x'}'y') ]

end
