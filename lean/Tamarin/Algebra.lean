import Std

/-!
# The sorted free algebra with C and AC symbols

This specifies the axioms of the ordinary Maude `unify` command emitted by
`crates/tamarin-term/src/maude_proc.rs`, not equality modulo rewrite rules.
There are deliberately no unit, idempotence, cancellation, or exponent laws.

Binary trees are mathematical syntax. `ACRepresentation.lean` proves the
nonempty-array folding, flattening, and permutation laws; the Rust adapter
still needs to be connected to them. There is no empty AC application;
a singleton array represents its sole child.
-/
namespace Tamarin

/-- The subsort order in `lterm.rs`, without Maude's transport-only TOP sort. -/
inductive SortId where
  | pub | fresh | msg | node | nat
  deriving DecidableEq, Repr

inductive Subsort : SortId → SortId → Prop where
  | refl (s) : Subsort s s
  | pub_msg : Subsort .pub .msg
  | fresh_msg : Subsort .fresh .msg
  | nat_msg : Subsort .nat .msg

theorem Subsort.trans {a b c : SortId} (h : Subsort a b) (k : Subsort b c) :
    Subsort a c := by
  cases h <;> cases k <;> constructor

/-- `id` is an injective encoding of Rust's full (name, sort, index) identity.
It is not just `LVar.idx`. Each sort has an unbounded supply of variables. -/
structure Variable where
  id : Nat
  sort : SortId
  deriving DecidableEq, Repr

/-- Symbol identities are abstract, separate namespaces. The adapter must
preserve all identity-bearing Rust attributes. Atoms are rigid names, including
skolem constants; they cannot be instantiated by a substitution.

C and AC operations are binary and homogeneous. Free symbols have fixed
arity and input/result sorts. This covers the declarations emitted by
`maude_print.rs`; equations attached to those declarations are not part of B.
No decidable equality or finite enumeration is needed to state the semantics. -/
structure Signature where
  FreeSym : Type
  CSym : Type
  ACSym : Type
  Atom : Type
  arity : FreeSym → Nat
  inputSort : (f : FreeSym) → Fin (arity f) → SortId
  outputSort : FreeSym → SortId
  cSort : CSym → SortId
  acSort : ACSym → SortId
  atomSort : Atom → SortId

inductive Term (sig : Signature) where
  | var : Variable → Term sig
  | atom : sig.Atom → Term sig
  | free : (f : sig.FreeSym) → (Fin (sig.arity f) → Term sig) → Term sig
  | comm : sig.CSym → Term sig → Term sig → Term sig
  | ac : sig.ACSym → Term sig → Term sig → Term sig

namespace Term
variable {sig : Signature}

/-- Occurrence is about variable identity, not printed names. -/
def Occurs (v : Variable) : Term sig → Prop
  | .var w => v = w
  | .atom _ => False
  | .free _ args => ∃ i, Occurs v (args i)
  | .comm _ a b | .ac _ a b => Occurs v a ∨ Occurs v b

/-- Simultaneous, one-step substitution. Images are not recursively chased.
Composition is stated explicitly in `Substitution.lean`. -/
def subst (σ : Variable → Term sig) : Term sig → Term sig
  | .var v => σ v
  | .atom a => .atom a
  | .free f args => .free f (fun i => subst σ (args i))
  | .comm f a b => .comm f (subst σ a) (subst σ b)
  | .ac f a b => .ac f (subst σ a) (subst σ b)

@[simp] theorem subst_id (t : Term sig) : subst Term.var t = t := by
  induction t with
  | var v => rfl
  | atom a => rfl
  | free f args ih => simp only [subst]; congr; funext i; exact ih i
  | comm f a b ha hb => simp only [subst, ha, hb]
  | ac f a b ha hb => simp only [subst, ha, hb]

theorem subst_comp (δ σ : Variable → Term sig) (t : Term sig) :
    subst δ (subst σ t) = subst (fun v => subst δ (σ v)) t := by
  induction t with
  | var v => rfl
  | atom a => rfl
  | free f args ih => simp only [subst]; congr; funext i; exact ih i
  | comm f a b ha hb => simp only [subst, ha, hb]
  | ac f a b ha hb => simp only [subst, ha, hb]

end Term

/-- A variable may be instantiated with a term of a narrower sort.
Node is incomparable with Msg, and Pub/Fresh/Nat are pairwise incomparable. -/
inductive HasSort {sig : Signature} : Term sig → SortId → Prop where
  | var (v) : HasSort (.var v) v.sort
  | atom (a) : HasSort (.atom a) (sig.atomSort a)
  | free (f args) (h : ∀ i, HasSort (args i) (sig.inputSort f i)) :
      HasSort (.free f args) (sig.outputSort f)
  | comm (f a b) (ha : HasSort a (sig.cSort f)) (hb : HasSort b (sig.cSort f)) :
      HasSort (.comm f a b) (sig.cSort f)
  | ac (f a b) (ha : HasSort a (sig.acSort f)) (hb : HasSort b (sig.acSort f)) :
      HasSort (.ac f a b) (sig.acSort f)
  | widen {t a b} : HasSort t a → Subsort a b → HasSort t b

theorem HasSort.subst {sig : Signature} {t : Term sig} {s : SortId}
    (h : HasSort t s) (σ : Variable → Term sig)
    (hσ : ∀ v, HasSort (σ v) v.sort) : HasSort (t.subst σ) s := by
  induction h with
  | var v => exact hσ v
  | atom a => exact .atom a
  | free f args _ ih => exact .free f _ ih
  | comm f a b _ _ ha hb => exact .comm f _ _ ha hb
  | ac f a b _ _ ha hb => exact .ac f _ _ ha hb
  | widen _ h ih => exact .widen ih h

/-- The least congruence generated by C and AC, called B-equivalence.
There is no constructor for arbitrary user equations or rewrite steps.
The relation is defined on raw syntax; solver inputs and substitutions must
also satisfy `HasSort`. This keeps typing obligations explicit. -/
inductive EquivB {sig : Signature} : Term sig → Term sig → Prop where
  | refl (t) : EquivB t t
  | symm {a b} : EquivB a b → EquivB b a
  | trans {a b c} : EquivB a b → EquivB b c → EquivB a c
  | free (f : sig.FreeSym) (a b : Fin (sig.arity f) → Term sig)
      (h : ∀ i, EquivB (a i) (b i)) : EquivB (.free f a) (.free f b)
  | comm_congr (f) {a b c d} : EquivB a c → EquivB b d →
      EquivB (.comm f a b) (.comm f c d)
  | ac_congr (f) {a b c d} : EquivB a c → EquivB b d →
      EquivB (.ac f a b) (.ac f c d)
  | comm_swap (f a b) : EquivB (.comm f a b) (.comm f b a)
  | ac_swap (f a b) : EquivB (.ac f a b) (.ac f b a)
  | ac_assoc (f a b c) : EquivB (.ac f (.ac f a b) c) (.ac f a (.ac f b c))

/-- C and AC equivalence preserves which variables occur in a term. -/
theorem EquivB.occurs_iff {sig : Signature} {a b : Term sig} (h : EquivB a b) (w : Variable) :
    a.Occurs w ↔ b.Occurs w := by
  induction h with
  | refl => rfl
  | symm _ ih => exact ih.symm
  | trans _ _ ih ik => exact ih.trans ik
  | free _ _ _ _ ih => exact exists_congr (fun i => ih i)
  | comm_congr _ _ _ ih ik | ac_congr _ _ _ ih ik => exact or_congr ih ik
  | comm_swap | ac_swap => exact or_comm
  | ac_assoc => exact or_assoc

/-- Applying the same substitution respects B-equivalence. -/
theorem EquivB.subst {sig : Signature} {a b : Term sig} (h : EquivB a b)
    (σ : Variable → Term sig) : EquivB (a.subst σ) (b.subst σ) := by
  induction h with
  | refl t => exact .refl _
  | symm _ ih => exact .symm ih
  | trans _ _ ha hb => exact .trans ha hb
  | free f a b _ ih => exact .free f _ _ ih
  | comm_congr f _ _ ha hb => exact .comm_congr f ha hb
  | ac_congr f _ _ ha hb => exact .ac_congr f ha hb
  | comm_swap f a b => exact .comm_swap f _ _
  | ac_swap f a b => exact .ac_swap f _ _
  | ac_assoc f a b c => exact .ac_assoc f _ _ _

/-- Substitution depends only on the variables occurring in the term. -/
theorem Term.subst_equiv {sig : Signature} (σ τ : Variable → Term sig)
    (t : Term sig) :
    (∀ v, t.Occurs v → EquivB (σ v) (τ v)) →
      EquivB (t.subst σ) (t.subst τ) := by
  induction t with
  | var v => intro h; exact h v rfl
  | atom a => intro _; exact .refl _
  | free f args ih =>
    intro h
    exact .free f _ _ (fun i => ih i (fun v hv => h v ⟨i, hv⟩))
  | comm f a b ha hb =>
    intro h
    exact .comm_congr f (ha (fun v hv => h v (Or.inl hv)))
      (hb (fun v hv => h v (Or.inr hv)))
  | ac f a b ha hb =>
    intro h
    exact .ac_congr f (ha (fun v hv => h v (Or.inl hv)))
      (hb (fun v hv => h v (Or.inr hv)))

end Tamarin
